<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grid used by everything"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/gridSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="Summon button (click point)"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/summonSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="Extra click point (optional, for the Extra click step)"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/extraSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <Button
            android:id="@+id/btnTestExtra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Test tap on the extra point" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="Times (all in milliseconds)"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:text="Type the same number in both boxes for a fixed time, or a range (for example 500 and 1000) to use a random time in that range every time." />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:text="Drag duration: how long each drag takes"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/dragMinInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="from (ms)"
                android:inputType="number" />

            <EditText
                android:id="@+id/dragMaxInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="to (ms)"
                android:inputType="number" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:text="Pause after each move (also the delay per merge)"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/pauseMinInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="from (ms)"
                android:inputType="number" />

            <EditText
                android:id="@+id/pauseMaxInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="to (ms)"
                android:inputType="number" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:text="Longest summon hold"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/holdMinInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="from (ms)"
                android:inputType="number" />

            <EditText
                android:id="@+id/holdMaxInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="to (ms)"
                android:inputType="number" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:text="Pause between loops"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/loopPauseMinInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="from (ms)"
                android:inputType="number" />

            <EditText
                android:id="@+id/loopPauseMaxInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="to (ms)"
                android:inputType="number" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:text="Countdown before a test button starts (time to switch to the game)"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/countdownMinInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="from (ms)"
                android:inputType="number" />

            <EditText
                android:id="@+id/countdownMaxInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="to (ms)"
                android:inputType="number" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="Loop"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Number of loops (0 = until stopped or nothing is left to do)"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/loopsInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="Sort passes per loop (the board is read again between passes, so a lag spike that made a drag miss gets fixed; stops early when it is sorted)"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/sortPassesInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Most drags in one sort pass (0 = all of them). A smaller number means the board is checked more often."
            android:textSize="12sp" />

        <EditText
            android:id="@+id/sortMovesInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

        <CheckBox
            android:id="@+id/checkSwap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Swap tiles when sorting: dropping a tile on a tile of a different level swaps them (the sort never drops on the same level). Unticked: only drop on empty squares." />

        <CheckBox
            android:id="@+id/checkReread"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Merge chain: read the board again after every merge. Unticked (recommended): the whole chain is planned from one scan, like the sort, and nothing is read while tiles are moving." />

        <CheckBox
            android:id="@+id/checkVerify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Safety checks: confirm each merge and the board after each step (slower, recommended)" />

        <CheckBox
            android:id="@+id/checkPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preview only for the Sort / Merge test buttons (the loop always runs for real)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="Loop steps, in order (tick = on)"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/stepsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Battery optimization settings" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:text="For long runs, set MyApp to Unrestricted battery use. The floating panel keeps the screen on while it is showing. Settings save automatically when you leave this screen." />

        <Button
            android:id="@+id/btnDone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Done" />

    </LinearLayout>
</ScrollView>
