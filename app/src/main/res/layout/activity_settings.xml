<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grid used by everything"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/gridSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="Summon button (click point)"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/summonSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="Extra click point (optional, for the Extra click step)"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/extraSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <Button
            android:id="@+id/btnTestExtra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Test tap on the extra point (5 s countdown)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="Speed"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Drag duration (ms): how long each drag takes"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/dragMsInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pause after each move (ms), also the delay per merge"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/pauseMsInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Longest summon hold (seconds)"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/maxHoldInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="Loop"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Number of loops (0 = until stopped or nothing is left to do)"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/loopsInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pause between loops (ms)"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/loopPauseInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

        <CheckBox
            android:id="@+id/checkSwap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dropping a tile on a different tile swaps them" />

        <CheckBox
            android:id="@+id/checkVerify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Safety checks: confirm each merge and the board after each step (slower, recommended)" />

        <CheckBox
            android:id="@+id/checkPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preview only for the Sort / Merge test buttons (the loop always runs for real)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="Loop steps, in order (tick = on)"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/stepsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Battery optimization settings" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:text="For long runs, set MyApp to Unrestricted battery use. The floating panel keeps the screen on while it is showing. Settings save automatically when you leave this screen." />

        <Button
            android:id="@+id/btnDone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Done" />

    </LinearLayout>
</ScrollView>
